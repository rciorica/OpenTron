<file path="frontend/src/styles/storage-dashboard.css">
/* Storage Dashboard Styles */

.storage-dashboard {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.storage-header {
  margin-bottom: 30px;
}

.storage-header h2 {
  font-size: 24px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 15px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.storage-tabs {
  display: flex;
  gap: 10px;
  border-bottom: 2px solid #333;
  padding-bottom: 10px;
}

.tab {
  padding: 8px 16px;
  background: transparent;
  border: none;
  color: #888;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  border-bottom: 3px solid transparent;
  margin-bottom: -10px;
}

.tab:hover {
  color: #0f9;
}

.tab.active {
  color: #0f9;
  border-bottom-color: #0f9;
}

/* Storage Stats Cards */
.storage-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 15px;
  margin-bottom: 30px;
}

.stat-card {
  background: rgba(15, 136, 153, 0.1);
  border: 1px solid rgba(15, 136, 153, 0.3);
  border-radius: 8px;
  padding: 15px;
  text-align: center;
  transition: all 0.3s ease;
}

.stat-card:hover {
  background: rgba(15, 136, 153, 0.15);
  border-color: rgba(15, 136, 153, 0.5);
  transform: translateY(-2px);
}

.stat-label {
  font-size: 12px;
  font-weight: 600;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.stat-value {
  font-size: 28px;
  font-weight: 700;
  color: #0f9;
  margin-bottom: 5px;
}

.stat-sublabel {
  font-size: 11px;
  color: #666;
}

/* Agent Section */
.agent-section {
  margin-bottom: 30px;
}

.agent-selector {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-bottom: 20px;
  padding: 15px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 6px;
}

.agent-selector label {
  font-weight: 600;
  color: #fff;
  min-width: 60px;
}

.agent-selector input {
  flex: 1;
  padding: 8px 12px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 4px;
  color: #fff;
  font-size: 14px;
}

.agent-selector input::placeholder {
  color: #666;
}

.agent-selector input:focus {
  outline: none;
  border-color: #0f9;
  background: rgba(255, 255, 255, 0.15);
}

.agent-selector button {
  padding: 8px 16px;
  background: #0f9;
  border: none;
  border-radius: 4px;
  color: #000;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.agent-selector button:hover {
  background: #0dd;
  transform: scale(1.05);
}

/* Tables */
.traces-table,
.memories-table {
  overflow-x: auto;
  border-radius: 6px;
  border: 1px solid rgba(15, 136, 153, 0.3);
}

table {
  width: 100%;
  border-collapse: collapse;
  background: rgba(255, 255, 255, 0.02);
}

thead {
  background: rgba(15, 136, 153, 0.1);
}

th {
  padding: 12px;
  text-align: left;
  font-weight: 600;
  color: #0f9;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 1px solid rgba(15, 136, 153, 0.3);
}

td {
  padding: 12px;
  color: #ccc;
  font-size: 13px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

tbody tr:hover {
  background: rgba(15, 136, 153, 0.1);
}

tbody tr:last-child td {
  border-bottom: none;
}

.memory-summary {
  max-width: 300px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.table-footer {
  padding: 12px;
  text-align: center;
  color: #666;
  font-size: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  background: rgba(0, 0, 0, 0.1);
}

/* Messages */
.storage-loading {
  padding: 40px 20px;
  text-align: center;
  color: #666;
  font-size: 14px;
}

.storage-error {
  padding: 15px;
  background: rgba(255, 68, 68, 0.1);
  border: 1px solid rgba(255, 68, 68, 0.3);
  border-radius: 6px;
  color: #ff6b6b;
  margin-bottom: 15px;
  font-size: 14px;
}

.storage-empty {
  padding: 30px;
  text-align: center;
  color: #666;
  font-size: 14px;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 6px;
  border: 1px dashed rgba(255, 255, 255, 0.1);
}

/* Responsive */
@media (max-width: 768px) {
  .storage-dashboard {
    padding: 15px;
  }

  .storage-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .storage-header h2 {
    font-size: 18px;
  }

  .agent-selector {
    flex-direction: column;
    align-items: flex-start;
  }

  .agent-selector input {
    width: 100%;
  }

  th, td {
    padding: 8px;
    font-size: 12px;
  }
}

@media (max-width: 480px) {
  .storage-stats {
    grid-template-columns: 1fr;
  }

  .storage-tabs {
    gap: 5px;
  }

  .tab {
    padding: 6px 10px;
    font-size: 12px;
  }

  .stat-value {
    font-size: 24px;
  }

  .stat-label {
    font-size: 11px;
  }
}
