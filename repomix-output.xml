            >
              Cancel
            </button>
            {optInEnabled && (
              <button
                onClick={handleOptOut}
                style={{
                  padding: '8px 14px',
                  borderRadius: 8,
                  background: 'transparent',
                  color: colors.red,
                  fontSize: 13,
                  border: `1px solid ${colors.border}`,
                  cursor: 'pointer',
