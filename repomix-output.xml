      {traces.length > 0 && (
        <div className="traces-table">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Agent</th>
                <th>Duration (ms)</th>
                <th>Timestamp</th>
                <th>Compressed</th>
