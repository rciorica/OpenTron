            <div style={styles.providerModel}>{p.provider}</div>
            <div style={styles.savingsAmount}>{fmtDollar(p.total_cost)}</div>
            <div style={styles.breakdown}>
              <div>
                <div style={styles.breakdownLabel}>Input Saved</div>
