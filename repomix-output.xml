                }}
              >
                Opt Out
              </button>
            )}
          </div>
        </div>
      ) : (
        <div style={{ marginBottom: 16, display: 'flex', alignItems: 'center', gap: 10 }}>
          <button
            onClick={() => setShowOptIn(true)}
            style={{
              padding: '6px 14px',
              borderRadius: 8,
              background: optInEnabled ? 'rgba(166,227,161,0.15)' : colors.surface,
