                            </execution>
                        </executions>
                        <configuration>
                            <skipTests>true</skipTests>
                            <imageName>opentron-backend-linux-x86_64</imageName>
                            <mainClass>org.opentron.backend.OpentronBackendApplication</mainClass>
                        </configuration>
