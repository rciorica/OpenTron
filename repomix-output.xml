        anon_id: anonId,
        display_name: displayName,
        email: emailStored,
        total_calls: data.total_calls,
        total_tokens: data.total_tokens,
        dollar_savings: dollarSavings,
        energy_wh_saved: energySaved,
        flops_saved: flopsSaved,
