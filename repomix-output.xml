              style={{
                width: '100%',
                padding: '8px 12px',
                borderRadius: 8,
                background: colors.bg,
                border: `1px solid ${colors.border}`,
                color: colors.text,
                fontSize: 14,
                outline: 'none',
                boxSizing: 'border-box',
              }}
            />
            {nameError && (
              <div style={{ fontSize: 12, color: colors.red, marginTop: 4 }}>{nameError}</div>
            )}
          </div>
          <div style={{ display: 'flex', gap: 8 }}>
            <button
